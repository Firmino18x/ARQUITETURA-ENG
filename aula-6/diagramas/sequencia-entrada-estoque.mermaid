sequenceDiagram
    title Rotina de entrada de estoque
    actor U as Usuário
    participant V as View (stock.html)
    participant C as StockController
    participant S as StockService
    participant P as Product (entidade)
    participant PR as ProductRepository
    participant MR as StockMovementRepository

    U->>V: Seleciona produto, tipo "Entrada" e quantidade
    V->>C: POST /stock (productId, ENTRADA, quantity)
    C->>S: register(productId, ENTRADA, quantity)
    S->>S: registerEntry(productId, quantity)
    S->>PR: findById(productId)
    alt produto não encontrado
        PR-->>S: Optional.empty()
        S-->>C: BusinessException("Produto não encontrado")
        C-->>V: tela de erro
    else produto encontrado
        PR-->>S: product
        S->>P: addStock(quantity)
        alt produto DESCONTINUADO ou quantidade <= 0
            P-->>S: BusinessException
            S-->>C: BusinessException (rollback)
            C-->>V: tela de erro com a mensagem
        else movimentação válida
            P->>P: quantity += amount
            opt saldo anterior era zero
                P->>P: status = DISPONÍVEL
            end
            P-->>S: ok
            S->>PR: save(product)
            S->>MR: save(StockMovement ENTRADA, saldo após)
            MR-->>S: movimento salvo
            S-->>C: StockMovement
            C-->>V: redirect:/stock
            V-->>U: Saldo e histórico atualizados
        end
    end
